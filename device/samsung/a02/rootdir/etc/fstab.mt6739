# Android fstab file — SESUAIKAN block device asli a02 lo (dari dmesg/parse partisi stok)
#<src>                                              <mnt_point>  <type>  <mnt_flags options>                                            <fs_mgr_flags>
/dev/block/platform/bootdevice/by-name/system       /system      ext4    ro,barrier=1                                                    wait
/dev/block/platform/bootdevice/by-name/vendor       /vendor      ext4    ro,barrier=1                                                    wait
/dev/block/platform/bootdevice/by-name/userdata     /data        ext4    noatime,nosuid,nodev,noauto_da_alloc,discard                     wait,check,fileencryption=aes-256-xts:aes-256-cts,quota,formattable
/dev/block/platform/bootdevice/by-name/cache        /cache       ext4    noatime,nosuid,nodev,discard                                     wait
